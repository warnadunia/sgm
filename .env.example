# --- Database (libSQL) ---
# Lokal: file SQLite biasa — tidak butuh layanan eksternal.
DATABASE_URL="file:./data/dev.db"
# Production (Turso — terhubung via Vercel Marketplace atau turso.tech):
# DATABASE_URL="libsql://nama-db-kamu.turso.io"
# DATABASE_AUTH_TOKEN="eyJhbGciOi...token-dari-turso..."

# --- Auth sesi admin (WAJIB diganti di production, string acak ≥32 karakter) ---
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# --- Akun admin awal (otomatis dibuat saat server pertama kali start / seed) ---
ADMIN_EMAIL="admin@studiografisminggiran.id"
ADMIN_PASSWORD="minggiran2026"

# --- Nomor WhatsApp untuk tombol pemesanan artshop (format internasional tanpa +) ---
NEXT_PUBLIC_WA_NUMBER="6281234567890"

# --- Vercel Blob (otomatis terisi ketika Blob store dihubungkan ke project Vercel) ---
# Tanpa variabel ini, upload admin disimpan ke folder lokal public/uploads (hanya dev/self-host).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
